ASADB_REPO_ROOT=/opt/asadb
ASADB_SWIPL=/usr/bin/swipl
ASADB_HOST=127.0.0.1
ASADB_PORT=7879
ASADB_PUBLIC_URL=https://db.example.com
ASADB_SECRET_KEY=replace-with-long-random-value
ASADB_CLUSTER_KEY=replace-with-a-different-long-random-value
ASADB_DATA_DIR=/var/lib/asadb/databases
ASADB_STATE_DIR=/var/lib/asadb/server-state
ASADB_TEMP_DIR=/var/lib/asadb/tmp
ASADB_THREAD_POOL_SIZE=8
ASADB_NODE_ID=node-1
ASADB_CLUSTER_ENABLED=false
